# 1. Базовий полегшений образ Python 3.10
FROM python:3.10-slim
# 2. Робоча директорія всередині контейнера (усі наступні команди виконуються тут)
WORKDIR /app
# 3. Спочатку копіюємо лише файл залежностей і встановлюємо їх 
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# 4. Копіюємо весь код проєкту з хоста в контейнер
COPY . .
# 5. Команда запуску сервера розробки Django на всіх мережевих інтерфейсах (0.0.0.0) і порту 8000
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]